#!/usr/bin/env python3
"""Tela base do Hydra OS: preto na TV no lugar do papel de parede, da barra e do dock, para cobrir o intervalo entre
o Neo fechar o BP e o jogo abrir (e o fim do jogo até o BP voltar).

Quem manda é o daemon do controle (~/.local/lib/console/daemon.py), pelo stdin, um comando por linha:
  off             tudo transparente (TV fora da área 4)
  base            preto só no nível "bottom": cobre o papel de parede, fica sempre por baixo das janelas
                  (o BP e o jogo em tela cheia aparecem normalmente)
  cover           preto também no nível "top", com o texto: cobre a barra, o dock e janelas soltas. Só no intervalo
                  sem nada em tela cheia na área 4 (quem sabe disso é o daemon)
  text <msg>      texto no centro do "cover", com um spinner ("text" sozinho: só preto)
  art <fundo>\t<logo>  arte do jogo no "cover": fundo escurecido e desfocado, logo no centro no lugar do texto
                  (caminhos de arquivo; vazio = sem; "art" sozinho tira a arte)
  sub <msg>       2ª linha, menor, embaixo do nome/logo (ex.: "Preparando na Steam…"); "sub" sozinho tira
  splash on|off   abertura: marca do Hydra e o nome no preto, por cima de tudo (entrada vinda da mesa ou do
                  PC acordando); "off" volta ao estado de antes
Fim do stdin (daemon parou): sai.

Por que duas camadas e não uma "top" que o Hyprland esconde atrás da tela cheia: esse esmaecimento não é confiável
para uma camada nova (Hyprland 0.56.2: a 1ª ida à área 4 depois de ela nascer deixou a TV preta por cima do BP, e
nem trocar de nível consertou). Uma camada "bottom" nunca fica por cima de janela; a "top" só aparece quando não
há tela cheia.
As camadas são sempre pretas e o estado as MOSTRA ou ESCONDE (mapeia/desmapeia), nunca só troca a cor: escondida
atrás de uma tela cheia, a camada não recebe o aviso de quadro exibido do Hyprland, o GTK para de desenhar e ela
congelava preta fora da área 4. Camada recém-mostrada desenha do zero. Cliques passam direto (input vazio). Regras de
camada no hyprland.lua: a "base" aparece e some sem animação, a "cover" esmaece (fade), como num console.
Uso: hydraos-backdrop --monitor "<descrição ou conector>"
"""
import os, sys, urllib.parse

LIB = "/usr/lib/libgtk4-layer-shell.so"
# o gtk4-layer-shell precisa ser carregado antes da libwayland-client; pelo Python, só com LD_PRELOAD
if LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = ":".join(p for p in (LIB, os.environ.get("LD_PRELOAD")) if p)
    os.execv(sys.executable, [sys.executable, *sys.argv])

import gi, cairo

gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_foreign("cairo")
from gi.repository import Gdk, Gio, GLib, Gtk, Gtk4LayerShell as Layer

MARK = os.path.expanduser("~/.local/lib/console/hydra-mark.png")  # marca do Hydra, branca com fundo transparente
CSS = """
window { background: #000; }
label { color: rgba(255, 255, 255, 0.6); font-size: %(text)dpx; }
spinner { color: rgba(255, 255, 255, 0.55); }
picture.hero { filter: blur(18px) brightness(0.45); }
label.sub { font-size: %(sub)dpx; color: rgba(255, 255, 255, 0.45); }
label.brand { font-size: %(brand)dpx; font-weight: 300; letter-spacing: 0.3em; color: rgba(255, 255, 255, 0.92); }
box.mark { background-image: url("file://%(mark)s"); background-size: contain; background-repeat: no-repeat;
           background-position: center; }
"""


def find_monitor(want):
    mons = Gdk.Display.get_default().get_monitors()
    for i in range(mons.get_n_items()):
        m = mons.get_item(i)
        if m.get_connector() == want or (m.get_description() or "").startswith(want):
            return m
    return None


def layer_window(app, monitor, level, namespace):
    win = Gtk.Window(application=app)
    Layer.init_for_window(win)
    Layer.set_layer(win, level)
    Layer.set_namespace(win, namespace)
    Layer.set_monitor(win, monitor)
    for edge in (Layer.Edge.TOP, Layer.Edge.BOTTOM, Layer.Edge.LEFT, Layer.Edge.RIGHT):
        Layer.set_anchor(win, edge, True)
    Layer.set_exclusive_zone(win, -1)  # cobre a barra em vez de respeitar o espaço dela
    Layer.set_keyboard_mode(win, Layer.KeyboardMode.NONE)
    return win


class Backdrop:
    def __init__(self, app, monitor):
        self.state, self.text, self.sub_text, self.splash, self.buf = "off", "", "", False, b""
        self.art = ("", "")
        self.base = layer_window(app, monitor, Layer.Layer.BOTTOM, "hydraos-base")
        self.cover = layer_window(app, monitor, Layer.Layer.TOP, "hydraos-cover")

        css = Gtk.CssProvider()
        h = monitor.get_geometry().height
        css.load_from_string(CSS % {"text": max(16, round(h * 0.025)), "sub": max(12, round(h * 0.018)),
                                    "brand": max(24, round(h * 0.045)), "mark": urllib.parse.quote(MARK)})
        Gtk.StyleContext.add_provider_for_display(self.cover.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        geo = monitor.get_geometry()
        self.label, self.spinner = Gtk.Label(), Gtk.Spinner()
        self.spinner.set_size_request(36, 36)
        self.hero = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True)
        self.hero.add_css_class("hero")
        # logo como fundo CSS de uma caixa de tamanho fixo: o Gtk.Picture pede o tamanho da imagem (logo de 1280 px
        # ocupava a TV inteira); o CSS escala para caber ("contain") e fica nítido na escala 2,4 da TV
        self.logo = Gtk.Box()
        self.logo.add_css_class("logo")
        self.logo.set_size_request(round(geo.width * 0.4), round(geo.height * 0.25))
        self.logo_css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(self.cover.get_display(), self.logo_css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self.sub = Gtk.Label()
        self.sub.add_css_class("sub")
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=32, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        for w in (self.logo, self.label, self.sub, self.spinner):
            self.box.append(w)
        layers = Gtk.Overlay(child=self.hero)
        layers.add_overlay(self.box)
        # abertura: marca + "Hydra", sem fundo de jogo
        mark = Gtk.Box()
        mark.add_css_class("mark")
        side = round(geo.height * 0.22)
        mark.set_size_request(side, side)
        brand = Gtk.Label(label="Hydra")
        brand.add_css_class("brand")
        splash = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=28, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        splash.append(mark)
        splash.append(brand)
        self.pages = Gtk.Stack()
        self.pages.add_named(layers, "loading")
        self.pages.add_named(splash, "splash")
        self.cover.set_child(self.pages)
        for win in (self.base, self.cover):
            # a cada vez que aparece (superfície nova no Hyprland): input vazio, cliques vão para o que está embaixo
            win.connect("map", lambda w: w.get_surface().set_input_region(cairo.Region()))
        self.render()
        GLib.io_add_watch(GLib.IOChannel.unix_new(0), GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP, self.stdin)

    def render(self):
        for win, on in ((self.base, self.state != "off" or self.splash), (self.cover, self.state == "cover" or self.splash)):
            win.set_visible(on)
        self.pages.set_visible_child_name("splash" if self.splash else "loading")
        show = self.state == "cover" and bool(self.text) and not self.splash
        self.sub.set_label(self.sub_text)
        self.sub.set_visible(bool(self.sub_text))
        hero, logo = self.art
        self.label.set_label(self.text)
        self.label.set_visible(not logo)  # com logo, o nome escrito sobra
        self.box.set_visible(show)
        self.spinner.set_spinning(show)
        if self.hero.get_file() is None or self.hero.get_file().get_path() != (hero or None):
            self.hero.set_filename(hero or None)
        self.hero.set_visible(bool(hero))
        if logo != getattr(self, "logo_path", None):
            self.logo_path = logo
            url = "file://" + urllib.parse.quote(logo) if logo else "none"
            self.logo_css.load_from_string(f'box.logo {{ background-image: url("{url}"); background-size: contain; '
                                           'background-repeat: no-repeat; background-position: center; }')
        self.logo.set_visible(bool(logo))

    def stdin(self, _channel, _cond):
        # os.read + split: o readline do Python guardaria linhas no buffer dele e o watch não dispararia de novo
        data = os.read(0, 4096)
        if not data:
            self.cover.get_application().quit()
            return False
        *lines, self.buf = (self.buf + data).split(b"\n")
        for line in lines:
            cmd, _, arg = line.decode(errors="replace").strip().partition(" ")
            if cmd in ("off", "base", "cover"):
                self.state = cmd
            elif cmd == "text":
                self.text = arg.strip()
            elif cmd == "sub":
                self.sub_text = arg.strip()
            elif cmd == "splash":
                self.splash = arg.strip() == "on"
            elif cmd == "art":
                hero, _, logo = arg.partition("\t")
                self.art = (hero.strip(), logo.strip())
        self.render()
        return True


def main():
    want = sys.argv[sys.argv.index("--monitor") + 1] if "--monitor" in sys.argv[:-1] else None
    if not want:
        sys.exit(__doc__.rsplit("Uso: ", 1)[1].strip())
    app = Gtk.Application(application_id="org.pharos.hydraos.backdrop", flags=Gio.ApplicationFlags.NON_UNIQUE)
    keep = []

    def activate(a):
        mon = find_monitor(want)
        if not mon:
            print(f"hydraos-backdrop: monitor {want!r} não encontrado", file=sys.stderr)
            a.quit()
            return
        keep.append(Backdrop(a, mon))
        # TV desligada ou em outra entrada: a saída some e a camada ficaria morta; sai, e o daemon reabre quando ela voltar
        mon.connect("invalidate", lambda *_: a.quit())

    app.connect("activate", activate)
    app.run([])


if __name__ == "__main__":
    main()
