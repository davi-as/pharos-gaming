<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharosGaming.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- Mesma paleta monocromática do PHAROS GAMING para Windows (Theme.xaml) -->
        <SolidColorBrush x:Key="Bg" Color="#000000"/>
        <SolidColorBrush x:Key="Card" Color="#0E0E0E"/>
        <SolidColorBrush x:Key="Line" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="LineStrong" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="Fg" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="Muted" Color="#8C8C8C"/>
        <SolidColorBrush x:Key="Faint" Color="#4A4A4A"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme/>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
        </Style>
        <Style Selector="TextBlock.big">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.val">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="WrapPanel.chips">
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style Selector="WrapPanel.chips > RadioButton">
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="{StaticResource Line}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
        </Style>
    </Application.Styles>
</Application>
