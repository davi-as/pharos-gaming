<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharosGaming.App"
             xmlns:local="using:PharosGaming"
             RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <!-- Cartão de resultado (discos, energia, rede, drivers...) -->
        <DataTemplate DataType="local:InfoCard" x:DataType="local:InfoCard">
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12"/>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="badge" Classes.alert="{Binding IsAlert}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding VerdictText}" FontSize="11" FontWeight="Bold" LetterSpacing="1"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Reasons}" Classes="dim" Foreground="{DynamicResource Fg}" Margin="0,4,0,4"/>
                    <ItemsControl ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:Object">
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,7,16,7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" FontSize="11" x:CompileBindings="False"/>
                                        <SelectableTextBlock Text="{Binding Value}" FontFamily="{StaticResource Sans}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                                                             Foreground="{DynamicResource Fg}" x:CompileBindings="False"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- Árvore de informações: grupo (título + filhos) ou linha "nome: valor" -->
        <DataTemplate DataType="local:InfoNode" x:DataType="local:InfoNode">
            <Panel>
                <Border IsVisible="{Binding !IsGroup}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid ColumnDefinitions="260,*">
                        <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,16,0"/>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <StackPanel IsVisible="{Binding IsGroup}" Margin="0,20,0,0">
                    <TextBlock Text="{Binding Display}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Children}"/>
                </StackPanel>
            </Panel>
        </DataTemplate>
        <!-- Medidor: rótulo, valor e barra -->
        <DataTemplate DataType="local:MeterItem" x:DataType="local:MeterItem">
            <StackPanel Margin="0,6,24,6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Sans}" Foreground="{DynamicResource Fg}"/>
                </Grid>
                <ProgressBar Maximum="1" Value="{Binding Fraction}" Margin="0,5,0,0"/>
            </StackPanel>
        </DataTemplate>
        <!-- Linha de resultado -->
        <DataTemplate DataType="local:Kv" x:DataType="local:Kv">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,6">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Sans}" Foreground="{DynamicResource Fg}"/>
                    </Grid>
                    <TextBlock Text="{Binding Hint}" IsVisible="{Binding HasHint}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Application.DataTemplates>
    <Application.Resources>
        <!-- Identidade do Pharos (~/Projects/pharos/docs/DESIGN.md): papiro de dia, noite do Nilo à noite.
             Lápis-lazúli é o que age; ouro é a luz; turquesa é ok; cornalina é alerta. O normal é silencioso. -->
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="AccentButtonBackground" Color="#6F98D8"/>
                <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#8FB0E2"/>
                <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#5A85C8"/>
                <SolidColorBrush x:Key="Bg" Color="#0A1424"/>
                <SolidColorBrush x:Key="Card" Color="#111C30"/>
                <SolidColorBrush x:Key="LineStrong" Color="#16223A"/>
                <SolidColorBrush x:Key="Line" Color="#1C2A44"/>
                <SolidColorBrush x:Key="Fg" Color="#F0E6D0"/>
                <SolidColorBrush x:Key="Muted" Color="#9AA6B8"/>
                <SolidColorBrush x:Key="Faint" Color="#5C6A85"/>
                <SolidColorBrush x:Key="Flame" Color="#6F98D8"/>
                <SolidColorBrush x:Key="OnFlame" Color="#0A1424"/>
                <SolidColorBrush x:Key="Glow" Color="#F0C14B"/>
                <SolidColorBrush x:Key="Ok" Color="#58C1B3"/>
                <SolidColorBrush x:Key="Bad" Color="#FF7F5E"/>
                <SolidColorBrush x:Key="BadFill" Color="#E0573A"/>
                <SolidColorBrush x:Key="Warn" Color="#F0C14B"/>
                <SolidColorBrush x:Key="AccentButtonForeground" Color="#0A1424"/>
                <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0A1424"/>
                <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0A1424"/>
                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#0A1424"/>
                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#0A1424"/>
                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#0A1424"/>
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0A1424"/>
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0A1424"/>
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0A1424"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="AccentButtonBackground" Color="#1F3F78"/>
                <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2B4F8F"/>
                <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#12264A"/>
                <SolidColorBrush x:Key="Bg" Color="#FFF8F0"/>
                <SolidColorBrush x:Key="Card" Color="#F7EDD7"/>
                <SolidColorBrush x:Key="LineStrong" Color="#F1E7D1"/>
                <SolidColorBrush x:Key="Line" Color="#E3D9C4"/>
                <SolidColorBrush x:Key="Fg" Color="#12264A"/>
                <SolidColorBrush x:Key="Muted" Color="#59657C"/>
                <SolidColorBrush x:Key="Faint" Color="#8D96A6"/>
                <SolidColorBrush x:Key="Flame" Color="#1F3F78"/>
                <SolidColorBrush x:Key="OnFlame" Color="#FFF8F0"/>
                <SolidColorBrush x:Key="Glow" Color="#C8982B"/>
                <SolidColorBrush x:Key="Ok" Color="#22706A"/>
                <SolidColorBrush x:Key="Bad" Color="#A33D26"/>
                <SolidColorBrush x:Key="BadFill" Color="#B6452C"/>
                <SolidColorBrush x:Key="Warn" Color="#7D5A10"/>
                <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFF8F0"/>
                <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFF8F0"/>
                <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFF8F0"/>
                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFF8F0"/>
                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFF8F0"/>
                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFF8F0"/>
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFF8F0"/>
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFF8F0"/>
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFF8F0"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <!-- destaque do Fluent = lápis-lazúli: o tema escuro usa as variantes Light, o claro as Dark -->
        <Color x:Key="SystemAccentColor">#3F6BB5</Color>
        <Color x:Key="SystemAccentColorLight1">#6F98D8</Color>
        <Color x:Key="SystemAccentColorLight2">#6F98D8</Color>
        <Color x:Key="SystemAccentColorLight3">#8FB0E2</Color>
        <Color x:Key="SystemAccentColorDark1">#1F3F78</Color>
        <Color x:Key="SystemAccentColorDark2">#1F3F78</Color>
        <Color x:Key="SystemAccentColorDark3">#12264A</Color>
        <FontFamily x:Key="Serif">avares://pharos-gaming/Assets/Fonts#Literata</FontFamily>
        <FontFamily x:Key="Sans">avares://pharos-gaming/Assets/Fonts#Fira Sans</FontFamily>
      </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme/>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <!-- legenda: Fira Sans 12, maiúsculas, 0.06em -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
        </Style>
        <!-- números de destaque e títulos: Literata 600 -->
        <Style Selector="TextBlock.big">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.serif">
            <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.val">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Item do menu lateral -->
        <Style Selector="RadioButton.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="999" Padding="14,5">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.nav:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>
        <Style Selector="RadioButton.nav:checked">
            <Setter Property="Background" Value="{DynamicResource LineStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Flame}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <!-- selo: o normal é silencioso (contorno discreto); só a exceção ganha cor (cornalina) -->
        <Style Selector="Border.badge">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style Selector="Border.badge.alert">
            <Setter Property="Background" Value="{DynamicResource BadFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadFill}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource OnFlame}"/>
        </Style>
        <!-- botões de texto em pílula -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="16,7"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <!-- Cabeçalho de página: título, status e ações -->
        <Style Selector="TextBlock.h2">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="WrapPanel.chips">
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style Selector="WrapPanel.chips > RadioButton">
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource Flame}"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
        </Style>
    </Application.Styles>
</Application>
