<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharosGaming.App"
             xmlns:local="using:PharosGaming"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <!-- Cartão de resultado (discos, energia, rede, drivers...) -->
        <DataTemplate DataType="local:InfoCard" x:DataType="local:InfoCard">
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Meta}" Classes="dim" FontSize="12"/>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="badge" Classes.alert="{Binding IsAlert}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding VerdictText}" FontSize="11" FontWeight="Bold" LetterSpacing="1"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Reasons}" Classes="dim" Foreground="{StaticResource Fg}" Margin="0,4,0,4"/>
                    <ItemsControl ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:Object">
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7,16,7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Key}" Foreground="{StaticResource Muted}" FontSize="11" x:CompileBindings="False"/>
                                        <SelectableTextBlock Text="{Binding Value}" FontFamily="monospace" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                                                             Foreground="{StaticResource Fg}" x:CompileBindings="False"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- Árvore de informações: grupo (título + filhos) ou linha "nome: valor" -->
        <DataTemplate DataType="local:InfoNode" x:DataType="local:InfoNode">
            <Panel>
                <Border IsVisible="{Binding !IsGroup}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid ColumnDefinitions="260,*">
                        <TextBlock Text="{Binding Header}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,16,0"/>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource Fg}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <StackPanel IsVisible="{Binding IsGroup}" Margin="0,20,0,0">
                    <TextBlock Text="{Binding Display}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Fg}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Children}"/>
                </StackPanel>
            </Panel>
        </DataTemplate>
        <!-- Medidor: rótulo, valor e barra -->
        <DataTemplate DataType="local:MeterItem" x:DataType="local:MeterItem">
            <StackPanel Margin="0,6,24,6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="monospace" Foreground="{StaticResource Fg}"/>
                </Grid>
                <ProgressBar Maximum="1" Value="{Binding Fraction}" Margin="0,5,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Application.DataTemplates>
    <Application.Resources>
        <!-- Mesma paleta monocromática do PHAROS GAMING para Windows (Theme.xaml) -->
        <SolidColorBrush x:Key="Bg" Color="#000000"/>
        <SolidColorBrush x:Key="Card" Color="#0E0E0E"/>
        <SolidColorBrush x:Key="Line" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="LineStrong" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="Fg" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="Muted" Color="#8C8C8C"/>
        <SolidColorBrush x:Key="Faint" Color="#4A4A4A"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme/>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
        </Style>
        <Style Selector="TextBlock.big">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.val">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Item do menu lateral -->
        <Style Selector="RadioButton.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,7">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.nav:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>
        <Style Selector="RadioButton.nav:checked">
            <Setter Property="Background" Value="{StaticResource LineStrong}"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="BorderBrush" Value="{StaticResource Fg}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource Fg}"/>
        </Style>
        <Style Selector="Border.badge.alert">
            <Setter Property="Background" Value="{StaticResource Fg}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource Bg}"/>
        </Style>
        <!-- Cabeçalho de página: título, status e ações -->
        <Style Selector="TextBlock.h2">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="WrapPanel.chips">
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style Selector="WrapPanel.chips > RadioButton">
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="{StaticResource Line}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
        </Style>
    </Application.Styles>
</Application>
