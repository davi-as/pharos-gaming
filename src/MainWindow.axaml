<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharosGaming.MainWindow"
        Title="PHAROS GAMING" Width="1360" Height="860" MinWidth="980" MinHeight="620"
        Background="{StaticResource Bg}">
    <Grid ColumnDefinitions="230,*">

        <!-- Menu lateral por categorias -->
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="PHAROS GAMING" FontWeight="Bold" FontSize="17" LetterSpacing="3"
                           Foreground="{StaticResource Fg}" Margin="18,18,18,10"/>
                <TextBlock x:Name="Version" DockPanel.Dock="Bottom" Classes="label" Margin="18,10"/>
                <ScrollViewer>
                    <StackPanel x:Name="Nav" Margin="8,0,8,10"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="14">
            <DockPanel Margin="6,0,6,8">
                <TextBlock x:Name="PageTitle" DockPanel.Dock="Left" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Fg}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="Status" Classes="dim" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
            <Panel x:Name="Pages" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
