<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharosGaming.IoBench">
    <Grid ColumnDefinitions="*,14,330">
        <StackPanel>
            <Border Classes="card" Margin="0">
                <StackPanel>
                    <TextBlock Classes="label" Text="RESULTADOS"/>
                    <ItemsControl x:Name="Result"/>
                    <TextBlock x:Name="Empty" Classes="dim" Text="Pressione INICIAR." Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <ProgressBar x:Name="Progress" Maximum="1" Margin="0,10,0,4"/>
            <TextBlock x:Name="Status" Classes="dim" Text="Pronto"/>
            <TextBlock x:Name="Note" Foreground="{StaticResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Column="2">
            <StackPanel Spacing="10">
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <StackPanel x:Name="DiskOptions" IsVisible="False">
                            <TextBlock Classes="label" Text="UNIDADE"/>
                            <WrapPanel x:Name="DrivePanel" Classes="chips"/>
                            <TextBlock Classes="label" Text="TAMANHO DO TESTE"/>
                            <WrapPanel x:Name="SizePanel" Classes="chips">
                                <RadioButton GroupName="DiskSize" Content="512 MB" Tag="512"/>
                                <RadioButton GroupName="DiskSize" Content="1 GB" Tag="1024" IsChecked="True"/>
                                <RadioButton GroupName="DiskSize" Content="4 GB" Tag="4096"/>
                            </WrapPanel>
                        </StackPanel>
                        <Button x:Name="BtnRun" Classes="accent" Content="INICIAR" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Run_Click"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="HISTÓRICO"/>
                        <ItemsControl x:Name="History"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
