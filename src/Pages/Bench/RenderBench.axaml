<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharosGaming.RenderBench">
    <Grid ColumnDefinitions="*,14,330">
        <StackPanel>
            <Border Classes="card" Margin="0" Padding="0" ClipToBounds="True">
                <Viewbox Stretch="Uniform">
                    <Panel Width="960" Height="540">
                        <Image x:Name="Img"/>
                        <Canvas x:Name="Buckets"/>
                        <TextBlock x:Name="Idle" Text="Pressione “Iniciar” para renderizar a cena" Foreground="{DynamicResource Muted}" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                </Viewbox>
            </Border>
            <ProgressBar x:Name="Progress" Maximum="1" Margin="0,10,0,4"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="Status" Classes="dim" Text="Pronto"/>
                <TextBlock x:Name="Elapsed" Grid.Column="1" FontFamily="{StaticResource Sans}" Foreground="{DynamicResource Muted}"/>
            </Grid>
        </StackPanel>
        <ScrollViewer Grid.Column="2">
            <StackPanel Spacing="10">
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="TESTE"/>
                        <WrapPanel x:Name="ModePanel" Classes="chips">
                            <RadioButton GroupName="RbMode" Content="Multi-core" Tag="mt"/>
                            <RadioButton GroupName="RbMode" Content="Single-core" Tag="st"/>
                            <RadioButton GroupName="RbMode" Content="Ambos" Tag="both" IsChecked="True"/>
                        </WrapPanel>
                        <TextBlock Classes="label" Text="DURAÇÃO"/>
                        <WrapPanel x:Name="DurationPanel" Classes="chips">
                            <RadioButton GroupName="RbDur" Content="1 passada" Tag="0" IsChecked="True"/>
                            <RadioButton GroupName="RbDur" Content="Mínimo 10 min" Tag="10"/>
                        </WrapPanel>
                        <Button x:Name="BtnRun" Classes="accent" Content="Iniciar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Run_Click"/>
                        <TextBlock x:Name="Hint" Classes="dim" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="RESULTADO"/>
                        <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Classes="dim" FontSize="12" Text="Multi-core"/>
                                <TextBlock x:Name="Mt" Classes="big" Text="—"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="dim" FontSize="12" Text="Single-core"/>
                                <TextBlock x:Name="St" Classes="big" Text="—"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="Ratio" Classes="dim" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="DURANTE O TESTE"/>
                        <ItemsControl x:Name="LiveRows"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="HISTÓRICO (MULTI / SINGLE)"/>
                        <TextBlock x:Name="HistoryEmpty" Classes="dim" Text="Nenhum resultado ainda."/>
                        <ItemsControl x:Name="History"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
