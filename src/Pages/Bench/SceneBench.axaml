<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharosGaming.SceneBench">
    <Grid ColumnDefinitions="*,14,330">
        <StackPanel>
            <Border Classes="card" Margin="0" Padding="0" ClipToBounds="True">
                <Panel>
                    <Image x:Name="Img" Stretch="Uniform"/>
                    <TextBlock x:Name="Idle" Text="VALE · CENA DE JOGO" Foreground="{DynamicResource Muted}" FontSize="22" Margin="0,120"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border Background="#99000000" CornerRadius="6" Padding="12,6" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Classes="label" Text="FPS AGORA"/>
                            <TextBlock x:Name="FpsNow" Classes="big" Text="—"/>
                        </StackPanel>
                    </Border>
                </Panel>
            </Border>
            <ProgressBar x:Name="Progress" Maximum="1" Margin="0,10,0,4"/>
            <TextBlock x:Name="Status" Classes="dim" Text="Pronto"/>
            <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Renderiza fora da tela em OpenGL 4.3, numa fila de frames medida pela própria GPU: o V-Sync e o compositor não interferem. A prévia acima é uma cópia reduzida, 4 vezes por segundo. Os sensores ficam pausados durante o teste (cada leitura do driver gera um engasgo)."/>
        </StackPanel>
        <ScrollViewer Grid.Column="2">
            <StackPanel Spacing="10">
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="RESOLUÇÃO"/>
                        <WrapPanel x:Name="ResPanel" Classes="chips">
                            <RadioButton GroupName="GbRes" Content="1080p" Tag="1920x1080" IsChecked="True"/>
                            <RadioButton GroupName="GbRes" Content="1440p" Tag="2560x1440"/>
                            <RadioButton GroupName="GbRes" Content="4K" Tag="3840x2160"/>
                        </WrapPanel>
                        <TextBlock Classes="label" Text="DURAÇÃO"/>
                        <WrapPanel x:Name="DurPanel" Classes="chips">
                            <RadioButton GroupName="GbDur" Content="30 s" Tag="30"/>
                            <RadioButton GroupName="GbDur" Content="60 s" Tag="60" IsChecked="True"/>
                        </WrapPanel>
                        <Button x:Name="BtnRun" Classes="accent" Content="INICIAR" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Run_Click"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="RESULTADO"/>
                        <ItemsControl x:Name="Result"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="HISTÓRICO"/>
                        <ItemsControl x:Name="History"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
