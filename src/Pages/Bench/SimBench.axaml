<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharosGaming.SimBench">
    <Grid ColumnDefinitions="*,14,330">
        <StackPanel>
            <Border Classes="card" Margin="0" Padding="0" ClipToBounds="True" Background="#050505">
                <Panel Height="440">
                    <Image x:Name="Img" Width="440" Height="440"/>
                    <TextBlock x:Name="Idle" Text="30 mil unidades em batalha" Foreground="{DynamicResource Muted}" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FpsNow" Classes="big" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Panel>
            </Border>
            <ProgressBar x:Name="Progress" Maximum="1" Margin="0,10,0,4"/>
            <TextBlock x:Name="Status" Classes="dim" Text="Pronto"/>
            <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Física e IA de 30 mil unidades divididas entre as threads, mais a thread principal que junta tudo, como num jogo de estratégia: mede quanto FPS a CPU aguenta."/>
        </StackPanel>
        <ScrollViewer Grid.Column="2">
            <StackPanel Spacing="10">
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="DURAÇÃO"/>
                        <WrapPanel x:Name="DurPanel" Classes="chips">
                            <RadioButton GroupName="SimDur" Content="20 s" Tag="20" IsChecked="True"/>
                            <RadioButton GroupName="SimDur" Content="60 s" Tag="60"/>
                        </WrapPanel>
                        <Button x:Name="BtnRun" Classes="accent" Content="Iniciar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Run_Click"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="RESULTADO"/>
                        <ItemsControl x:Name="Result"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="HISTÓRICO"/>
                        <ItemsControl x:Name="History"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
