<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharosGaming.BottleneckPage">
    <ScrollViewer>
        <StackPanel Margin="6,6,16,6">
            <TextBlock Classes="dim" Text="Descobre o que está limitando o seu FPS: GPU, CPU, memória ou temperatura" Margin="0,0,0,14"/>
            <Grid ColumnDefinitions="*,14,*" Margin="0,0,0,12">
                <!-- Equilíbrio teórico -->
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="EQUILÍBRIO DO HARDWARE"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock x:Name="CpuName" Classes="dim"/>
                            <TextBlock x:Name="GpuName" Grid.Column="1" Classes="dim"/>
                        </Grid>
                        <!-- Escala: esquerda = GPU fraca para a CPU; centro = equilibrado; direita = CPU fraca para a GPU -->
                        <Panel Height="22" Margin="0,8,0,4">
                            <Border Height="4" Background="{DynamicResource Line}" VerticalAlignment="Center"/>
                            <Border Width="2" Height="10" Background="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Canvas x:Name="BalanceCanvas">
                                <Ellipse x:Name="BalanceDot" Width="14" Height="14" Fill="{DynamicResource Fg}" Canvas.Top="4"/>
                            </Canvas>
                        </Panel>
                        <Grid ColumnDefinitions="*,*,*">
                            <TextBlock Text="limita a GPU" Foreground="{DynamicResource Faint}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="equilibrado" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="limita a CPU" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="BalanceText" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Text="Estimativa pelo desempenho relativo típico; o detector ao vivo mostra a realidade de cada jogo."
                                   Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Veredito ao vivo -->
                <Border x:Name="LiveCard" Grid.Column="2" Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="LiveLabel" Classes="label" Text="AGORA"/>
                        <TextBlock x:Name="LiveTitle" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                        <TextBlock x:Name="LiveGame" Classes="dim" Margin="0,4,0,10"/>
                        <TextBlock x:Name="LiveAdvice" Classes="dim"/>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Leituras ao vivo -->
            <Border Classes="card" Margin="0,0,0,12" Padding="18,16,18,6">
                <StackPanel>
                    <TextBlock Classes="label" Text="LEITURAS AO VIVO"/>
                    <ItemsControl x:Name="Meters" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- Sessão -->
            <Border Classes="card" Margin="0">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="label" Text="ANÁLISE DE SESSÃO"/>
                            <TextBlock Classes="dim" Text="Clique em iniciar, abra o jogo (com o MangoHud ligado para o FPS) e jogue normalmente. Ao final você recebe o diagnóstico."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
                            <WrapPanel x:Name="DurationPanel" Classes="chips" Margin="0" VerticalAlignment="Center">
                                <RadioButton GroupName="BnDur" Content="1 min" Tag="1" IsChecked="True"/>
                                <RadioButton GroupName="BnDur" Content="3 min" Tag="3"/>
                                <RadioButton GroupName="BnDur" Content="5 min" Tag="5"/>
                            </WrapPanel>
                            <Button x:Name="BtnSession" Classes="accent" Content="INICIAR ANÁLISE" Click="Session_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SessionStatus" Classes="dim" Margin="0,14,0,0"/>
                    <StackPanel x:Name="Result" IsVisible="False" Margin="0,16,0,0">
                        <TextBlock x:Name="ResultTitle" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                        <TextBlock x:Name="ResultSummary" Classes="dim" Margin="0,4,0,14"/>
                        <ItemsControl x:Name="Distribution"/>
                        <TextBlock x:Name="ResultAdvice" Foreground="{DynamicResource Fg}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
