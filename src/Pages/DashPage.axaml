<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PharosGaming"
             x:Class="PharosGaming.DashPage">
<Grid ColumnDefinitions="*,*,*" RowDefinitions="1.2*,Auto,*">

            <!-- FPS -->
            <Border Classes="card" Grid.ColumnSpan="2">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <StackPanel>
                            <TextBlock Classes="label" Text="FPS"/>
                            <TextBlock x:Name="FpsText" Text="—" FontSize="64" FontWeight="Bold" Foreground="{StaticResource Fg}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="28,0,0,0">
                            <TextBlock Classes="label" Text="FRAMETIME"/>
                            <TextBlock x:Name="FtText" Classes="big" Text="—"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="28,0,0,0">
                            <TextBlock Classes="label" Text="MÍNIMO 10 s"/>
                            <TextBlock x:Name="MinText" Classes="big" Text="—"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="28,0,0,0">
                            <TextBlock Classes="label" Text="MÉDIA DA SESSÃO"/>
                            <TextBlock x:Name="AvgText" Classes="big" Text="—"/>
                        </StackPanel>
                    </Grid>
                    <Panel Grid.Row="1" Margin="0,12,0,0">
                        <Canvas x:Name="FpsChart" ClipToBounds="True" MinHeight="80"/>
                        <!-- Sem FPS: como ligar o MangoHud -->
                        <StackPanel x:Name="Setup" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Classes="dim" Text="Nenhum jogo enviando FPS. O PHAROS lê o FPS pelo MangoHud: cole isto nas opções de inicialização do jogo (Steam › Propriedades › Opções de inicialização) e abra o jogo."/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="LaunchOption" IsReadOnly="True" FontFamily="monospace" FontSize="12"/>
                                <Button Grid.Column="1" Content="Copiar" Margin="8,0,0,0" Click="CopyLaunch_Click"/>
                            </Grid>
                            <TextBlock Classes="dim" FontSize="11" Text="Se você já liga o log do MangoHud por conta própria (atalho ou autostart_log no MangoHud.conf), o PHAROS também encontra."/>
                        </StackPanel>
                    </Panel>
                </Grid>
            </Border>

            <!-- Gargalo -->
            <Border Classes="card" Grid.Column="2" Grid.RowSpan="2">
                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="GARGALO AGORA"/>
                    <TextBlock x:Name="LimTitle" Classes="big" FontSize="24" Text="—" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LimAdvice" Classes="dim"/>
                    <TextBlock Classes="label" Text="SESSÃO DE JOGO" Margin="0,18,0,0"/>
                    <TextBlock x:Name="SessionInfo" Classes="dim" Text="Começa quando o jogo envia FPS."/>
                    <TextBlock x:Name="SessionDist" Classes="val" LineHeight="22"/>
                </StackPanel>
            </Border>

            <!-- GPU / CPU / RAM -->
            <Border Classes="card" Grid.Row="1">
                <StackPanel>
                    <TextBlock Classes="label" Text="GPU"/>
                    <TextBlock x:Name="GpuName" Classes="dim" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="GpuLoad" Classes="big" Text="—"/>
                    <ProgressBar x:Name="GpuBar" Maximum="100"/>
                    <TextBlock x:Name="GpuDetail" Classes="val"/>
                    <TextBlock Classes="label" Text="VRAM" Margin="0,12,0,0"/>
                    <ProgressBar x:Name="VramBar" Maximum="100"/>
                    <TextBlock x:Name="VramText" Classes="val"/>
                </StackPanel>
            </Border>
            <Border Classes="card" Grid.Row="1" Grid.Column="1">
                <StackPanel>
                    <TextBlock Classes="label" Text="CPU"/>
                    <TextBlock x:Name="CpuName" Classes="dim" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CpuLoad" Classes="big" Text="—"/>
                    <ProgressBar x:Name="CpuBar" Maximum="100"/>
                    <TextBlock x:Name="CpuDetail" Classes="val"/>
                    <TextBlock Classes="label" Text="RAM" Margin="0,12,0,0"/>
                    <ProgressBar x:Name="RamBar" Maximum="100"/>
                    <TextBlock x:Name="RamText" Classes="val"/>
                </StackPanel>
            </Border>

            <!-- Histórico de carga -->
            <Border Classes="card" Grid.Row="2" Grid.ColumnSpan="3">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <TextBlock Classes="label" Text="CARGA · ÚLTIMOS 2 MIN"/>
                        <TextBlock Classes="label" Text="━ GPU" Foreground="{StaticResource Fg}"/>
                        <TextBlock Classes="label" Text="━ CPU (thread mais ocupada)"/>
                    </StackPanel>
                    <Canvas x:Name="LoadChart" Grid.Row="1" ClipToBounds="True" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
</UserControl>
