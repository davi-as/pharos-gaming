<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharosGaming.EnergyPage">
    <ScrollViewer>
        <StackPanel Margin="6,6,16,6">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <TextBlock x:Name="Status" Classes="dim" Text="Bateria, fonte de energia e consumo" VerticalAlignment="Center"/>
                <Button x:Name="BtnRefresh" Grid.Column="1" Content="Atualizar" Click="Refresh_Click"/>
            </Grid>
            <ItemsControl x:Name="Cards"/>
            <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"
                       Text="Os dados vêm do kernel (/sys/class/power_supply) e do power-profiles-daemon. Alguns notebooks não informam ciclos de carga ou a capacidade de projeto. O consumo mostrado vem dos sensores de CPU, GPU e SSD, não da fonte (PSU) do PC."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
