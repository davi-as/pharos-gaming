<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PharosGaming"
             x:Class="PharosGaming.MakerDrvPage">
    <ScrollViewer>
        <StackPanel Margin="6,6,16,6" Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock x:Name="Status" Classes="dim" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Verificar" VerticalAlignment="Top" Click="Scan_Click"/>
            </Grid>
            <Border Classes="card" Margin="0">
                <StackPanel>
                    <TextBlock Classes="label" Text="DRIVERS DO KERNEL"/>
                    <ItemsControl x:Name="Chips" Margin="0,6,0,0"/>
                    <TextBlock x:Name="LoadResult" Foreground="{DynamicResource Fg}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="&quot;Não carregado&quot; é normal sem placa conectada: o kernel carrega o módulo sozinho ao plugar. Se a placa estiver plugada e o driver não carregar, use CARREGAR."/>
                </StackPanel>
            </Border>
            <Border Classes="card" Margin="0">
                <StackPanel>
                    <TextBlock Classes="label" Text="PLACAS E CONVERSORES CONECTADOS"/>
                    <TextBlock x:Name="NoDevices" Classes="dim" Text="Nenhuma placa ou conversor serial conectado. Plugue a placa e clique em “Verificar”." Margin="0,6,0,0"/>
                    <ItemsControl x:Name="Devices" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Classes="card" Margin="0">
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="ARDUINO IDE"/>
                    <TextBlock x:Name="Ide" Classes="dim"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnIde" Content="Instalar a IDE" Click="Ide_Click"/>
                        <Button Content="Limpar cache da IDE" Click="Cache_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="IdeResult" Foreground="{DynamicResource Fg}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
