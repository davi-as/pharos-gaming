<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharosGaming.OverlayPage">
    <ScrollViewer>
        <StackPanel Margin="6,6,16,6">
            <TextBlock Classes="dim" Margin="0,0,0,14"
                       Text="FPS, frametime e sensores por cima do jogo. No Linux quem desenha o overlay é o MangoHud: o PHAROS gera a configuração dele com o que você escolher aqui."/>
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <CheckBox x:Name="ChkEnabled" Content="Usar o overlay do PHAROS nos jogos abertos pelo PHAROS" IsCheckedChanged="Enabled_Changed"/>
                    <TextBlock Classes="dim" FontSize="12"
                               Text="Desligado, o jogo usa o seu próprio MangoHud.conf (GOverlay, por exemplo). Ligado, o PHAROS usa um arquivo próprio e não mexe no seu."/>
                    <CheckBox x:Name="ChkVisible" Content="Mostrar ao abrir o jogo (Ctrl + Shift + Q liga e desliga)" IsCheckedChanged="Option_Changed"/>
                    <TextBlock x:Name="ToolNote" Classes="dim" FontSize="12"/>
                </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,14,*" Margin="0,0,0,12">
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="POSIÇÃO"/>
                        <WrapPanel x:Name="CornerPanel" Classes="chips">
                            <RadioButton GroupName="OvCorner" Content="Superior esquerdo" Tag="TL" IsCheckedChanged="Option_Changed"/>
                            <RadioButton GroupName="OvCorner" Content="Superior direito" Tag="TR" IsCheckedChanged="Option_Changed"/>
                            <RadioButton GroupName="OvCorner" Content="Inferior esquerdo" Tag="BL" IsCheckedChanged="Option_Changed"/>
                            <RadioButton GroupName="OvCorner" Content="Inferior direito" Tag="BR" IsCheckedChanged="Option_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="TAMANHO"/>
                        <WrapPanel x:Name="ScalePanel" Classes="chips">
                            <RadioButton GroupName="OvScale" Content="Pequeno" Tag="0.8" IsCheckedChanged="Option_Changed"/>
                            <RadioButton GroupName="OvScale" Content="Médio" Tag="1" IsCheckedChanged="Option_Changed"/>
                            <RadioButton GroupName="OvScale" Content="Grande" Tag="1.3" IsCheckedChanged="Option_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="label" Text="O QUE MOSTRAR"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="SÓ FPS" Tag="min" FontSize="11" Click="Preset_Click"/>
                            <Button Content="PADRÃO" Tag="default" FontSize="11" Click="Preset_Click"/>
                            <Button Content="TUDO" Tag="all" FontSize="11" Click="Preset_Click"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="Items"/>
                </StackPanel>
            </Border>
            <Border Classes="card" Margin="0">
                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="COMO LIGAR NO JOGO"/>
                    <TextBlock Classes="dim" Text="Jogos da Biblioteca do PHAROS já recebem tudo ao clicar em APLICAR NAS OPÇÕES DA STEAM (ou JOGAR, nos jogos manuais). Para outros launchers (Lutris, Heroic), use esta linha:"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="LaunchLine" IsReadOnly="True" FontFamily="{StaticResource Sans}" FontSize="12" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="Copiar" Margin="8,0,0,0" VerticalAlignment="Top" Click="Copy_Click"/>
                    </Grid>
                    <TextBlock x:Name="FileNote" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
