<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PharosGaming.OverlayPage">
    <ScrollViewer>
        <StackPanel Margin="6,6,16,6">
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="ChkEnabled" OnContent="Overlay do PHAROS em todos os jogos" OffContent="Overlay do PHAROS desligado" IsCheckedChanged="Enabled_Changed"/>
                    <TextBlock Classes="dim" FontSize="12"
                               Text="Vale para os jogos do Hydra e da Steam (os dois já carregam o MangoHud). Ligado, o PHAROS grava o MangoHud.conf e guarda o seu (GOverlay, por exemplo); desligado, o seu volta."/>
                    <CheckBox x:Name="ChkVisible" Content="Mostrar ao abrir o jogo (Ctrl + Shift + Q ou View + Start no controle liga e desliga)" IsCheckedChanged="Option_Changed"/>
                    <TextBlock x:Name="ToolNote" Classes="dim" FontSize="12"/>
                    <TextBlock x:Name="FileNote" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,14,*" Margin="0,0,0,12">
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="POSIÇÃO"/>
                        <WrapPanel x:Name="CornerPanel" Classes="chips">
                            <RadioButton GroupName="OvCorner" Content="Superior esquerdo" Tag="TL" IsCheckedChanged="Option_Changed"/>
                            <RadioButton GroupName="OvCorner" Content="Superior direito" Tag="TR" IsCheckedChanged="Option_Changed"/>
                            <RadioButton GroupName="OvCorner" Content="Inferior esquerdo" Tag="BL" IsCheckedChanged="Option_Changed"/>
                            <RadioButton GroupName="OvCorner" Content="Inferior direito" Tag="BR" IsCheckedChanged="Option_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="TAMANHO"/>
                        <WrapPanel x:Name="ScalePanel" Classes="chips">
                            <RadioButton GroupName="OvScale" Content="Pequeno" Tag="0.8" IsCheckedChanged="Option_Changed"/>
                            <RadioButton GroupName="OvScale" Content="Médio" Tag="1" IsCheckedChanged="Option_Changed"/>
                            <RadioButton GroupName="OvScale" Content="Grande" Tag="1.3" IsCheckedChanged="Option_Changed"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="label" Text="O QUE MOSTRAR"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="Só FPS" Tag="min" FontSize="11" Click="Preset_Click"/>
                            <Button Content="Padrão" Tag="default" FontSize="11" Click="Preset_Click"/>
                            <Button Content="Tudo" Tag="all" FontSize="11" Click="Preset_Click"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="Items"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
