<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PharosGaming"
             x:Class="PharosGaming.SensorsPage">
    <Grid RowDefinitions="Auto,Auto,*" Margin="6">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock x:Name="Status" Classes="dim" Text="Lendo sensores…" VerticalAlignment="Center"/>
            <TextBox x:Name="Search" Grid.Column="1" Width="260" Watermark="Buscar sensor ou hardware…" TextChanged="Search_Changed"/>
        </Grid>
        <WrapPanel x:Name="Chips" Grid.Row="1" Classes="chips"/>
        <Border Grid.Row="2" Classes="card" Margin="0" Padding="14,10">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,130,130,120,120" Margin="0,0,14,6">
                    <TextBlock Classes="label" Text="SENSOR"/>
                    <TextBlock Grid.Column="1" Classes="label" Text="TIPO"/>
                    <TextBlock Grid.Column="2" Classes="label" Text="VALOR"/>
                    <TextBlock Grid.Column="3" Classes="label" Text="MÍN."/>
                    <TextBlock Grid.Column="4" Classes="label" Text="MÁX."/>
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="Groups" Margin="0,0,14,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:SensorGroup">
                                <StackPanel>
                                    <TextBlock Text="{Binding Hardware}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Fg}" Margin="0,16,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:SensorRow">
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,5">
                                                    <Grid ColumnDefinitions="*,130,130,120,120">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{StaticResource Muted}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="monospace" Foreground="{StaticResource Fg}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Min}" FontFamily="monospace" Foreground="{StaticResource Muted}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Max}" FontFamily="monospace" Foreground="{StaticResource Muted}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
