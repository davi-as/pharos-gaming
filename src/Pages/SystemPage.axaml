<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PharosGaming"
             x:Class="PharosGaming.SystemPage">
    <Grid RowDefinitions="Auto,*" Margin="6">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <TextBlock x:Name="Sub" Classes="dim" Text="Lendo informações do sistema…" VerticalAlignment="Center"/>
            <Button x:Name="BtnReport" Grid.Column="1" Content="EXPORTAR RELATÓRIO" Click="Report_Click"
                    ToolTip.Tip="Salva um relatório (HTML ou JSON) com sistema, RAM, discos, GPU, sensores e benchmarks. Números de série são omitidos."/>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="220,18,*">
            <ListBox x:Name="Categories" Background="Transparent" SelectionChanged="Categories_Changed">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:InfoNode">
                        <TextBlock Text="{Binding Header}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Classes="card" Margin="0">
                <ScrollViewer>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock x:Name="InfoTitle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Fg}" Margin="0,0,0,8"/>

                        <!-- Unidades (só em Armazenamento): anel de cheio/vazio por sistema de arquivos montado -->
                        <StackPanel x:Name="DrivesPanel" IsVisible="False" Margin="0,4,0,8">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Classes="label" Text="UNIDADES MONTADAS"/>
                                <TextBlock x:Name="DrivesSummary" Grid.Column="1" Classes="dim" FontSize="12"/>
                            </Grid>
                            <ItemsControl x:Name="DriveCards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DriveCard">
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,10,10"
                                                Background="{StaticResource Bg}">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <!-- Anel: trilha = vazio, arco claro = usado -->
                                                <Panel Width="76" Height="76" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <Ellipse Stroke="{StaticResource Line}" StrokeThickness="8"/>
                                                    <Arc StartAngle="-90" SweepAngle="{Binding Sweep}" Stroke="{StaticResource Fg}" StrokeThickness="8"/>
                                                    <TextBlock Text="{Binding UsedPercent}" FontFamily="monospace" FontSize="14" Foreground="{StaticResource Fg}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Panel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Sizes}" Classes="dim" FontSize="12"/>
                                                    <TextBlock Text="{Binding Meta}" Foreground="{StaticResource Faint}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="label" Text="DISCOS FÍSICOS" Margin="0,14,0,0"/>
                        </StackPanel>

                        <ItemsControl x:Name="Details"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
