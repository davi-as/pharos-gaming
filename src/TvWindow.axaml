<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharosGaming.TvWindow"
        Title="Pharos Gaming · TV" Icon="/Assets/icon-192.png" WindowState="FullScreen" Width="1600" Height="900"
        Background="{DynamicResource Bg}">
    <Window.Styles>
        <Style Selector="Button.tile">
            <Setter Property="Padding" Value="24,18"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
        </Style>
        <Style Selector="Button.tile:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Flame}"/>
            <Setter Property="Background" Value="{DynamicResource NavActive}"/>
        </Style>
        <Style Selector="TextBlock.tvlabel">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
        </Style>
        <Style Selector="TextBlock.tvbig">
            <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>
        <Style Selector="TextBlock.tv">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Margin="72,48">
        <!-- cabeçalho -->
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="52" Height="52" CornerRadius="13" ClipToBounds="True"><Image Source="/Assets/icon-192.png"/></Border>
                <TextBlock Text="Pharos" Classes="tvbig" FontSize="36" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="Clock" Grid.Column="2" Classes="tv" FontSize="24" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="1.05*,40,1.5*" Margin="0,36,0,0">
            <!-- sessão -->
            <Border Classes="card" Margin="0" Padding="34,30" VerticalAlignment="Top">
                <StackPanel Spacing="14">
                    <TextBlock Classes="tvlabel" Text="AGORA"/>
                    <TextBlock x:Name="Game" Classes="tvbig" FontSize="40" Text="Nenhum jogo aberto" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock x:Name="Fps" Classes="tvbig" FontSize="96" Text="—"/>
                        <TextBlock x:Name="Ft" Classes="tv" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
                    </StackPanel>
                    <TextBlock Classes="tvlabel" Text="ACIMA DE 60 NESTA SESSÃO"/>
                    <Grid ColumnDefinitions="*" Height="12">
                        <Border Background="{DynamicResource Line}" CornerRadius="6"/>
                        <Border x:Name="FloorBar" Background="{DynamicResource Ok}" CornerRadius="6" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <Grid x:Name="Stats" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"/>
                </StackPanel>
            </Border>

            <!-- ajustes rápidos -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Classes="tvlabel" Text="AJUSTES RÁPIDOS · VALEM COM O JOGO ABERTO" Margin="0,0,0,14"/>
                <Grid x:Name="Tiles" Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"/>
                <Border x:Name="TipBox" Grid.Row="2" BorderBrush="{DynamicResource Warn}" BorderThickness="2" CornerRadius="16" Padding="22,16" Margin="0,4,16,0">
                    <TextBlock x:Name="Tip" Classes="tv" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>

        <!-- rodapé -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock Classes="tv" VerticalAlignment="Center" Foreground="{DynamicResource Faint}"
                       Text="A: muda · B: volta ao jogo · direcional: escolhe · Guide + View abre e fecha"/>
            <Button x:Name="BtnClose" Grid.Column="1" Classes="tile" Margin="0" Padding="30,16" Click="Close_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource ic-play-circle-outline}" Width="26" Height="26"/>
                    <TextBlock Text="Voltar ao jogo" FontSize="22" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
