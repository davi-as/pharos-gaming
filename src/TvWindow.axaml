<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharosGaming.TvWindow"
        Title="Pharos Gaming · TV" Icon="/Assets/icon-192.png" WindowState="FullScreen" Width="1600" Height="900"
        Background="{DynamicResource Bg}">
    <Window.Styles>
        <Style Selector="Button.tv">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Padding" Value="34,18"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Margin" Value="0,0,18,18"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.tv:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Flame}"/>
            <Setter Property="Background" Value="{DynamicResource NavActive}"/>
        </Style>
        <Style Selector="Button.tv.current /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Flame}"/>
        </Style>
        <Style Selector="TextBlock.tvlabel">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="TextBlock.tvbig">
            <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="80,56">
        <!-- cabeçalho -->
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="56" Height="56" CornerRadius="14" ClipToBounds="True"><Image Source="/Assets/icon-192.png"/></Border>
                <TextBlock Text="Pharos" Classes="tvbig" FontSize="38" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="Clock" Grid.Column="2" Classes="tvbig" FontSize="38" VerticalAlignment="Center"/>
        </Grid>

        <!-- jogo -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,48,0,0">
            <StackPanel>
                <TextBlock Classes="tvlabel" Text="JOGO"/>
                <TextBlock x:Name="Game" Classes="tvbig" FontSize="56" Text="Nenhum jogo aberto" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Verdict" FontSize="24" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="LastSession" FontSize="20" Foreground="{DynamicResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Classes="tvlabel" Text="FPS" HorizontalAlignment="Right"/>
                <TextBlock x:Name="Fps" Classes="tvbig" FontSize="120" Text="—" HorizontalAlignment="Right" Margin="0,-20,0,0"/>
                <TextBlock x:Name="Ft" FontSize="22" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- limite -->
        <StackPanel Grid.Row="2" Margin="0,44,0,0">
            <TextBlock x:Name="LimitLabel" Classes="tvlabel" Text="LIMITE DE FPS"/>
            <WrapPanel x:Name="Limits"/>
        </StackPanel>

        <!-- hardware -->
        <UniformGrid x:Name="Hw" Grid.Row="3" Columns="4" Margin="0,26,0,0"/>

        <!-- ações -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button x:Name="BtnBp" Classes="tv" Click="Bp_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource ic-play-circle-outline}" Width="28" Height="28"/>
                    <TextBlock Text="Big Picture do Hydra"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnClose" Classes="tv" Click="Close_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource ic-close-circle}" Width="28" Height="28"/>
                    <TextBlock Text="Fechar"/>
                </StackPanel>
            </Button>
            <TextBlock FontSize="20" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="12,0,0,18"
                       Text="Direcional ou analógico: escolher · A: confirmar · B: sair"/>
        </StackPanel>
    </Grid>
</Window>
