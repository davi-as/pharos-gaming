<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PharosGaming.TvWindow"
        Title="Pharos Gaming · TV" Icon="/Assets/icon-192.png" WindowState="FullScreen" Width="1600" Height="900"
        RequestedThemeVariant="Dark" Background="#070E1A">
    <Window.Resources>
        <!-- vidro escuro sobre a noite do Nilo; lápis-lazúli só no foco e no que está ligado -->
        <SolidColorBrush x:Key="TvGlass" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="TvGlassHi" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TvEdge" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="TvInk" Color="#F0E6D0"/>
        <SolidColorBrush x:Key="TvSoft" Color="#A8B3C5"/>
        <SolidColorBrush x:Key="TvFaint" Color="#6B7891"/>
        <SolidColorBrush x:Key="TvLapis" Color="#6F98D8"/>
        <SolidColorBrush x:Key="TvOk" Color="#58C1B3"/>
        <SolidColorBrush x:Key="TvWarn" Color="#F0C14B"/>
        <SolidColorBrush x:Key="TvBad" Color="#FF7F5E"/>
    </Window.Resources>
    <Window.Styles>
        <!-- botão: vidro com borda fina; foco cresce com mola suave, ganha luz e borda em lápis-lazúli; aperto afunda -->
        <Style Selector="Button.tile">
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{StaticResource TvGlass}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TvEdge}"/>
            <Setter Property="Foreground" Value="{StaticResource TvInk}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <!-- sem o retângulo branco de foco do Avalonia: o foco é a borda arredondada e o brilho -->
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tile /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TvGlassHi}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TvEdge}"/>
            <Setter Property="Foreground" Value="{StaticResource TvInk}"/>
        </Style>
        <Style Selector="Button.tile:focus">
            <Setter Property="RenderTransform" Value="scale(1.035)"/>
            <Setter Property="ZIndex" Value="1"/>
        </Style>
        <Style Selector="Button.tile:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A3F6BB5"/>
            <Setter Property="BorderBrush" Value="{StaticResource TvLapis}"/>
            <Setter Property="BoxShadow" Value="0 12 40 0 #806F98D8"/>
        </Style>
        <Style Selector="Button.tile:pressed">
            <Setter Property="RenderTransform" Value="scale(0.985)"/>
        </Style>
        <Style Selector="Button.tile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A3F6BB5"/>
        </Style>
        <Style Selector="Button.tile:disabled">
            <Setter Property="Opacity" Value="0.42"/>
        </Style>
        <Style Selector="Button.tile:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TvGlass}"/>
        </Style>
        <!-- ícone do botão num círculo; ligado = lápis-lazúli -->
        <Style Selector="Border.ico">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Background" Duration="0:0:0.25"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ico.on">
            <Setter Property="Background" Value="#3F6BB5"/>
        </Style>
        <Style Selector="TextBlock.cap">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TvFaint}"/>
            <Setter Property="LetterSpacing" Value="1.6"/>
        </Style>
        <Style Selector="TextBlock.soft">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Foreground" Value="{StaticResource TvSoft}"/>
        </Style>
        <Style Selector="TextBlock.serif">
            <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TvInk}"/>
        </Style>
        <!-- etiqueta dos botões do controle (como na Steam) -->
        <Style Selector="Border.key">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
        <Style Selector="Border.key > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TvInk}"/>
        </Style>
    </Window.Styles>

    <Panel>
        <!-- luz de fundo: lápis-lazúli vindo de cima à esquerda, um toque de ouro embaixo à direita -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="18%,0%" GradientOrigin="18%,0%" RadiusX="85%" RadiusY="95%">
                    <GradientStop Color="#2A1F3F78" Offset="0"/>
                    <GradientStop Color="#00070E1A" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="100%,100%" GradientOrigin="100%,100%" RadiusX="60%" RadiusY="60%">
                    <GradientStop Color="#12C8982B" Offset="0"/>
                    <GradientStop Color="#00070E1A" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="Root" RowDefinitions="Auto,*,Auto" Margin="72,44,72,36" Opacity="0">
            <!-- cabeçalho: a marca (o Φ do ícone no lugar do P) e o estado -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="Phi" Data="{StaticResource pharos-phi}" Fill="{StaticResource TvInk}" Stretch="Uniform" Height="50"
                          VerticalAlignment="Bottom" Margin="0,0,1,1" Opacity="0" RenderTransformOrigin="50%,100%"/>
                    <StackPanel x:Name="Word" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border x:Name="BatteryRow" CornerRadius="999" Background="{StaticResource TvGlass}" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <PathIcon Data="{StaticResource ic-controller}" Width="20" Height="20" Foreground="{StaticResource TvSoft}"/>
                            <TextBlock x:Name="Battery" FontSize="17" Foreground="{StaticResource TvSoft}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="999" Background="{StaticResource TvGlass}" Padding="18,8">
                        <TextBlock x:Name="Clock" FontSize="19" FontWeight="Medium" Foreground="{StaticResource TvInk}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="0.95*,30,1.6*" Margin="0,30,0,0">
                <!-- a sessão -->
                <Border x:Name="SessionCard" CornerRadius="28" Background="{StaticResource TvGlass}" BorderBrush="{StaticResource TvEdge}" BorderThickness="1"
                        Padding="32,26" VerticalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                        <TextBlock Classes="cap" Text="AGORA"/>
                        <TextBlock x:Name="Game" Grid.Row="1" Classes="serif" FontSize="38" Text="Nenhum jogo aberto" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                            <TextBlock x:Name="Fps" Classes="serif" FontSize="80" Text="—"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,18" Spacing="2">
                                <TextBlock Text="FPS" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TvSoft}"/>
                                <TextBlock x:Name="Ft" Classes="soft" FontSize="16"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Spacing="10" Margin="0,2,0,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="cap" Text="ACIMA DE 60 NESTA SESSÃO"/>
                                <TextBlock x:Name="FloorPct" Grid.Column="1" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TvInk}"/>
                            </Grid>
                            <Panel Height="10">
                                <Border Background="#1AFFFFFF" CornerRadius="5"/>
                                <Border x:Name="FloorBar" CornerRadius="5" HorizontalAlignment="Left" Width="0">
                                    <Border.Transitions><Transitions><DoubleTransition Property="Width" Duration="0:0:0.6" Easing="CubicEaseOut"/></Transitions></Border.Transitions>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                            <GradientStop Color="#2F8F86" Offset="0"/>
                                            <GradientStop Color="#58C1B3" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Panel>
                        </StackPanel>
                        <Grid x:Name="Stats" Grid.Row="4" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"/>
                        <StackPanel Grid.Row="6" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="cap" Text="TEMPO DE CADA QUADRO · 1 MIN"/>
                                <TextBlock x:Name="GraphNote" Grid.Column="1" FontSize="14" Foreground="{StaticResource TvFaint}"/>
                            </Grid>
                            <Panel Height="56">
                                <Canvas x:Name="Graph" ClipToBounds="True"/>
                            </Panel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ajustes -->
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                    <TextBlock Classes="cap" Text="AJUSTES RÁPIDOS" Margin="8,0,0,6"/>
                    <Grid x:Name="Tiles" Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"/>
                    <Border x:Name="TipBox" Grid.Row="2" CornerRadius="22" Background="{StaticResource TvGlass}" BorderThickness="1.5"
                            Padding="20,14" Margin="7,10,7,0" VerticalAlignment="Top">
                        <Border.Transitions><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.4"/></Transitions></Border.Transitions>
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon x:Name="TipIcon" Data="{StaticResource ic-check-circle}" Width="26" Height="26" VerticalAlignment="Top" Margin="0,1,14,0"/>
                            <TextBlock x:Name="Tip" Grid.Column="1" Classes="soft" FontSize="17" TextWrapping="Wrap" LineHeight="24" MaxLines="3"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- rodapé: os botões do controle -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" Spacing="26" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10"><Border Classes="key"><TextBlock Text="A"/></Border><TextBlock Classes="soft" Text="Mudar" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10"><Border Classes="key"><TextBlock Text="B"/></Border><TextBlock Classes="soft" Text="Voltar ao jogo" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10"><Border Classes="key"><PathIcon Data="{StaticResource ic-controller}" Width="18" Height="18" Foreground="{StaticResource TvInk}"/></Border><TextBlock Classes="soft" Text="Guide + View abre e fecha" VerticalAlignment="Center"/></StackPanel>
                </StackPanel>
                <Button x:Name="BtnClose" Grid.Column="1" Classes="tile" Margin="0" Padding="30,14" Click="Close_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource ic-play-circle-outline}" Width="24" Height="24"/>
                        <TextBlock Text="Voltar ao jogo" FontSize="20" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Panel>
</Window>
